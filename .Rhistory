library(tidyverse)
repo <- "~/Desktop/SENNET/"
setwd(repo)
### Import raw summary data and generate metadata
metadata <- readxl::read_excel("TNK/sennet_flow_olink_overlap_summary_tnk.xlsx")
metadata <- metadata %>% dplyr::filter(subject_id != "11004-0585")
patient_ID <- unique(metadata$subject_id)
threshold <- 55
metadata$age_class <- ifelse(metadata$age <= threshold, 0, 1)
metadata <- metadata %>% arrange(-desc(age_class))
metadata$group <- rep(1:5, 9)
write_csv(metadata, "TNK_metadata.csv")
### Import TNK flow data
flow_df <- read_csv("TNK_flow_data.csv")
flow_df %>% head()
#### Check patient ID
length(unique(flow_df$subject_id)) == length(patient_ID)
length(intersect(unique(flow_df$subject_id), patient_ID)) == length(patient_ID)
#### arcsinh transformed and save
flow_df %>% select(-...1, -subject_id) -> flow_value
flow_value <- asinh(flow_value / 150)
flow_demographic <- data.frame(patient_id = flow_df$subject_id)
# Create a vector of subject IDs in the same order as flow_demographic
subject_idx <- match(flow_demographic$patient_id, metadata$subject_id)
# Lookup corresponding age_class values
flow_demographic$outcome <- metadata$age_class[subject_idx]
flow_df_transformed <- cbind(flow_value, flow_demographic)
colnames(flow_df_transformed)
flow_df <- read_csv("TNK_flow_data.csv")
flow_df %>% head()
#### Check patient ID
length(unique(flow_df$subject_id)) == length(patient_ID)
length(intersect(unique(flow_df$subject_id), patient_ID)) == length(patient_ID)
#### arcsinh transformed and save
flow_df %>% select(-...1, -subject_id) -> flow_value
flow_value <- asinh(flow_value / 150)
flow_demographic <- data.frame(patient_id = flow_df$subject_id)
# Create a vector of subject IDs in the same order as flow_demographic
subject_idx <- match(flow_demographic$patient_id, metadata$subject_id)
# Lookup corresponding age_class values
flow_demographic$outcome <- metadata$age_class[subject_idx]
flow_df_transformed <- cbind(flow_value, flow_demographic)
nrow(flow_df_transformed)
nrow(flow_df_transformed) / length(patient_ID)
### Subsetting with 10% of the cells to reduce computational burden
set.seed(259)
flow_df_transformed_10percent <- flow_df_transformed[sample(1:nrow(flow_df_transformed), floor(nrow(flow_df_transformed)/10)),]
nrow(flow_df_transformed)
nrow(flow_df_transformed_10percent)
write_csv(flow_df_transformed_10percent, "TNK_flow_df_transformed_10percent.csv")
